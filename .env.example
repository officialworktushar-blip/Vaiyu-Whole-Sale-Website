# --- Database ---
# Your PostgreSQL connection string (Supabase, Neon, etc.)
DATABASE_URL="postgresql://postgres:password@localhost:5432/vaiyu_industries"

# --- Admin session signing ---
# Long random string used to sign the admin session cookie.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="generate-a-long-random-secret"

# --- Supabase Storage (product & banner images) ---
# Public-facing project URL and anon key (safe to expose in the browser).
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only key for uploading to storage (never expose in the browser).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Emails (order confirmations & admin notifications via Gmail SMTP) ---
# Enable 2-Step Verification, then create an App Password: https://myaccount.google.com/apppasswords
EMAIL_USER="your-gmail-address@gmail.com"
EMAIL_APP_PASSWORD="your-16-character-gmail-app-password"
# Where order notifications are sent to (typically your own address).
ADMIN_EMAIL="your-email@example.com"

# --- Site / admin user ---
# Canonical site URL used for Open Graph meta tags (no trailing slash).
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
# Used by `npm run db:seed:admin` to create/update the admin login in production.
ADMIN_PASSWORD="a-strong-password"

# --- Optional ---
# Number used by the floating WhatsApp button (wa.me link). If unset, a
# placeholder number is used, so set a real one (or remove the button).
WHATSAPP_NUMBER="919999999999"
